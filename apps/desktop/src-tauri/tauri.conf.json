{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veneer",
  "version": "0.1.0",
  "identifier": "com.veneer.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Veneer",
        "width": 1080,
        "height": 760,
        "minWidth": 760,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' asset: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
